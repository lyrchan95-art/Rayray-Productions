# ── Auth.js ──────────────────────────────────────────────
AUTH_SECRET=                     # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=                    # smtp://user:pass@host:587  (unset → magic link is printed to the server log)
EMAIL_FROM="Idea2Proto <no-reply@example.com>"
DEV_LOGIN=1                      # dev only: one-click sign-in, ignored when NODE_ENV=production

# ── Models (unset keys → deterministic mock provider, app still works offline) ──
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4.6
GLM_CHEAP_MODEL=glm-4-flash
GLM_VISION_MODEL=glm-4v-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CODE_MODEL=deepseek-chat

# OpenRouter: one key for both GLM and DeepSeek; used for any role without a direct key above
OPENROUTER_API_KEY=
OPENROUTER_CHEAP_MODEL=z-ai/glm-4.5-air
OPENROUTER_CHAT_MODEL=z-ai/glm-4.6
OPENROUTER_VISION_MODEL=z-ai/glm-4.5v
OPENROUTER_CODE_MODEL=deepseek/deepseek-chat-v3.1

# ── Speech-to-text (OpenAI-compatible /audio/transcriptions endpoint) ──
STT_API_KEY=                     # defaults to GLM_API_KEY
STT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
STT_MODEL=glm-asr
STT_LANGUAGE=yue

# ── Publishing (unset R2 → files saved locally and served from /p/<slug>) ──
PUBLIC_BASE_URL=http://localhost:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=              # e.g. https://pub-xxxx.r2.dev

# ── Usage & billing ──
FREE_DAILY_MESSAGES=20
PRO_DAILY_MESSAGES=300
FREE_CAN_PUBLISH=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
